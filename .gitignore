# dependencies
/node_modules
/.pnp
.pnp.*

# next.js build output
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# production
/build

# env
.env
.env*.local

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# PRIVATE SOURCE MATERIAL — never commit, never deploy.
# The resume PDF contains a phone number and email address. The site is built
# from data/resume.ts instead, which deliberately carries no contact details.
# ---------------------------------------------------------------------------
*.pdf
/logo/

# Generated by scripts/watermark-images.mjs from media-src/.
# The pristine originals must stay out of public/, or they would be served
# alongside the watermarked copies and make the watermark pointless.
/public/media/

# Harvest build for premium encryption — contains every locked topic in full.
/out-premium-src/

# ---------------------------------------------------------------------------
# Premium article source. Lives in the private bhargavamandapati/
# aaos-premium-content repo instead of here, and is checked out into these
# paths at build time (see .github/workflows/deploy.yml) or by
# scripts/fetch-premium-content.sh for local dev. Never track it here again —
# that would put paywalled content back in this public repo's history.
# ---------------------------------------------------------------------------
/content/learn/
/content/sdv/
/content/tutorials/

# ---------------------------------------------------------------------------
# Android TWA wrapper (.github/workflows/build-android.yml). The Gradle
# project is generated fresh from the live site on every run — only the
# generator and its small override config are tracked.
# ---------------------------------------------------------------------------
/android/node_modules/
/android/app-project/
/android/*.keystore
